NODE_ENV=development
PORT=3000

JWT_SECRET=change-me-to-a-long-random-secret-of-32-chars-or-more
JWT_EXPIRES_IN_SECONDS=3600

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SSL=false
CONTROL_DATABASE_NAME=zaku_control
TENANT_DATABASE_POOL_MAX=5
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=30000
TENANT_STATUS_CACHE_TTL_MS=30000

REDIS_URL=redis://localhost:6379

# Express "trust proxy": false, true, hop count (1) or comma separated subnets. Needed behind a load balancer.
TRUST_PROXY=false

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_CREDENTIALS_MAX_REQUESTS=10
RATE_LIMIT_CREDENTIALS_PER_IP_MAX_REQUESTS=60

# Defaults to true outside production
# SWAGGER_ENABLED=true
# SCALAR_ENABLED=true

# "*" mocks every external adapter, "tenants.*" a whole module, "users.repository" a single port. Empty = real adapters.
MOCK_ADAPTERS=
MOCK_SEED_DATA=false
