{
  "name": "web-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "build:dev": "node scripts/with-env.mjs dev build",
    "build:qa": "node scripts/with-env.mjs qa build",
    "build:cer": "node scripts/with-env.mjs cer build",
    "build:production": "node scripts/with-env.mjs production build",
    "start": "next start",
    "start:dev": "node scripts/with-env.mjs dev start",
    "start:qa": "node scripts/with-env.mjs qa start",
    "start:cer": "node scripts/with-env.mjs cer start",
    "start:production": "node scripts/with-env.mjs production start",
    "lint": "eslint \"{src,test}/**/*.{ts,tsx}\" && node scripts/check-boundaries.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "services:status": "node scripts/services-status.mjs"
  },
  "dependencies": {
    "@zaku/shared-types": "workspace:*",
    "clsx": "^2.1.1",
    "iron-session": "^9.0.1",
    "lucide-react": "^1.52.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.14.0"
  }
}
