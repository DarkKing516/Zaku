# Server-only variables: none uses NEXT_PUBLIC_, so Next.js never inlines them into the browser bundle.
# Copy this file to .env.local for local development. Validated in src/shared/server/env.ts.

# Environment where the app runs: local | dev | cert | qa | prod. Only `local` shows test helpers (demo credentials on /login).
APP_ENV=local

# iron-session cookie encryption key (>= 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_SECONDS=28800
# Defaults to Secure only in production. Set "false" if QA runs over plain HTTP.
# SESSION_COOKIE_SECURE=

# Simulated latency of the mocks (ms) and timeout of real requests (ms).
MOCK_LATENCY_MS=350
HTTP_TIMEOUT_MS=15000

# api-core base URL including the global prefix. Only needed when a service runs in REAL mode.
API_CORE_URL=http://localhost:3000/api
