    "migration:run": "pnpm build && typeorm -d dist/data-source.js migration:run"
  },
  "dependencies": {
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "pg": "^8.12.0",
    "ts-node": "^10.9.2",
    "typeorm-ts-node-commonjs": "^0.3.20"
  }
}
